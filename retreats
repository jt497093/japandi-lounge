          href="https://wa.me/31615230319"
          target="_blank"
          rel="noopener"
          class="cta">
          Ask About Retreats
        </a>
      </div>

    </nav>
  </div>
</header>

<main>

  <!-- HERO -->

  <section class="hero">
    <div class="container">

      <div class="heroVisual">

        <img
          src="images/JL_GardenFire.jpeg"
          alt="Retreat setting at Japandi Lounge">

        <div class="heroShade"></div>

        <div class="heroContent">

          <div class="eyebrow">
            Rest • Nature • Connection
          </div>

          <h1 class="heroTitle">
            Retreats at Japandi Lounge
          </h1>

          <p class="heroLead">
            A peaceful countryside setting near Den Bosch where you can
            slow down, step away from everyday noise and reconnect through
            nature, breathwork, ice-bath sessions, sound healing and time together.
          </p>

          <div class="ctaRow">

            <a
              class="btn primary"
              href="https://wa.me/31615230319"
              target="_blank"
              rel="noopener">
              Ask About Retreats
            </a>

            <a
              class="btn"
              href="#create">
              Create Your Own Retreat
            </a>

          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- INTRO -->

  <section class="section">
    <div class="container">

      <div class="split">

        <div class="card">

          <span class="sectionLabel">
            A different pace
          </span>

          <h2>
            Space to slow down
          </h2>

          <p>
            Japandi Lounge is a restored Brabant farmhouse surrounded by
            peaceful countryside near ’s-Hertogenbosch.
          </p>

          <p>
            The house combines Japanese minimalism with Scandinavian warmth,
            creating an atmosphere designed for rest, reflection and meaningful
            time together.
          </p>

          <p>
            Whether you join one of our retreats or create your own by adding
            our available activities to your stay, Japandi Lounge offers a calm
            setting to slow down, reset and recharge.
          </p>

        </div>

        <div class="gallery">

          <div class="img">
            <img
              src="images/JL_GardenSaunaEve.jpeg"
              alt="Sauna at Japandi Lounge">
          </div>

          <div class="img">
            <img
              src="images/JL_LivingroomStudy.jpeg"
              alt="Calm Japandi interior">
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- EXPERIENCES -->

  <section
    id="experiences"
    class="section">

    <div class="container">

      <div class="sectionIntro">

        <span class="sectionLabel">
          Experiences
        </span>

        <h2>
          Add experiences to your stay
        </h2>

        <p>
          Build a retreat around the experiences that fit your group.
          Activities can be combined with your stay to create a slower,
          more intentional few days at Japandi Lounge.
        </p>

      </div>

      <div class="experienceGrid">

        <div class="card experience">
          <div>
            <span class="number">01</span>

            <h3>
              Breathwork
            </h3>

            <p>
              Step away from distraction and create space for focused breathing,
              calm and connection.
            </p>
          </div>
        </div>

        <div class="card experience">
          <div>
            <span class="number">02</span>

            <h3>
              Ice-bath sessions
            </h3>

            <p>
              Combine cold exposure with the peaceful outdoor setting of
              Japandi Lounge for an energising retreat experience.
            </p>
          </div>
        </div>

        <div class="card experience">
          <div>
            <span class="number">03</span>

            <h3>
              Sound healing
            </h3>

            <p>
              Slow the pace and settle into a quieter atmosphere with
              sound-based relaxation sessions.
            </p>
          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- CREATE YOUR OWN -->

  <section
    id="create"
    class="section">

    <div class="container">

      <div class="split">

        <div class="card darkCard">

          <span class="sectionLabel" style="color:rgba(255,255,255,.62)">
            Flexible retreats
          </span>

          <h2>
            Create your own retreat
          </h2>

          <p>
            You do not have to join a fixed retreat programme to experience
            Japandi Lounge as a retreat destination.
          </p>

          <p>
            Book the house for your group and add available activities such
            as breathwork, ice-bath sessions or sound healing to your stay.
          </p>

          <p>
            This gives you the freedom to create your own pace, structure
            and combination of experiences.
          </p>

          <div class="ctaRow">

            <a
              class="btn primary"
              href="https://wa.me/31615230319"
              target="_blank"
              rel="noopener">
              Build Your Retreat
            </a>

          </div>

        </div>

        <div class="img wide">
          <img
            src="images/JL_GardenFire.jpeg"
            alt="Evening fire at Japandi Lounge">
        </div>

      </div>

    </div>
  </section>

  <!-- THE STAY -->

  <section
    id="stay"
    class="section">

    <div class="container">

      <div class="split">

        <div class="card">

          <span class="sectionLabel">
            The setting
          </span>

          <h2>
            More than the sessions
          </h2>

          <p>
            The retreat experience continues between activities. Japandi Lounge
            offers indoor and outdoor spaces designed for slowing down and
            spending time together.
          </p>

          <ul class="list">
            <li>Sauna</li>
            <li>Wood-fired hot tub / jacuzzi</li>
            <li>Outdoor fire pit</li>
            <li>Large communal kitchen</li>
            <li>Long dining table for shared meals</li>
            <li>Indoor and outdoor lounge areas</li>
            <li>Peaceful countryside near Den Bosch</li>
          </ul>

        </div>

        <div class="gallery">

          <div class="img">
            <img
              src="images/JL_Kitchen.jpeg"
              alt="Communal kitchen at Japandi Lounge">
          </div>

          <div class="img">
            <img
              src="images/JL_LivingroomSofa2.jpeg"
              alt="Living room at Japandi Lounge">
          </div>

          <div class="img">
            <img
              src="images/JL_Hall.jpeg"
              alt="Japandi Lounge interior">
          </div>

          <div class="img">
            <img
              src="images/JL_Bedroom1.jpeg"
              alt="Bedroom at Japandi Lounge">
          </div>

        </div>

      </div>

    </div>
  </section>

  <!-- FINAL CTA -->

  <section class="section">
    <div class="container">

      <div class="card finalCta">

        <span class="sectionLabel">
          Retreats at Japandi Lounge
        </span>

        <h2>
          Slow down. Reset. Reconnect.
        </h2>

        <p>
          Tell us what you have in mind and we can discuss the stay,
          the available retreat activities and what would suit your group.
        </p>

        <div class="ctaRow">

          <a
            class="btn primary"
            href="https://wa.me/31615230319"
            target="_blank"
            rel="noopener">
            Start a WhatsApp Conversation
          </a>

          <a
            class="btn"
            href="/">
            Back to Japandi Lounge
          </a>

        </div>

      </div>

    </div>
  </section>

</main>

<footer class="footer">

  <div class="container">

    <div class="footerInner">

      <div>
        © <span id="y"></span> Japandi Lounge
      </div>

      <div>
        Retreats near ’s-Hertogenbosch, North Brabant
      </div>

      <div>
        WhatsApp:
        <a href="https://wa.me/31615230319">
          +31 6 15230319
        </a>
      </div>

    </div>

  </div>

</footer>

