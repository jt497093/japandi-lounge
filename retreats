  <title>Retreats at Japandi Lounge | Nature, Breathwork, Ice Baths & Sound Healing</title>

  <meta
    name="description"
    content="Retreats at Japandi Lounge near Den Bosch. Slow down in nature with breathwork, ice-bath sessions, sound healing, sauna, hot tub and a calm Japandi setting."
  >

  <meta name="robots" content="index, follow">
  <link rel="canonical" href="https://japandilounge.com/retreats.html">

  <meta property="og:title" content="Retreats at Japandi Lounge">
  <meta
    property="og:description"
    content="A calm countryside retreat setting near Den Bosch with breathwork, ice baths, sound healing, sauna, hot tub and space to reconnect."
  >
  <meta property="og:type" content="website">
  <meta property="og:url" content="https://japandilounge.com/retreats.html">
  <meta property="og:image" content="images/JL_GardenFire.jpeg">

  <style>
    :root {
      --bg: #eee0cf;
      --bg-soft: #f5ecdf;
      --card: #f8f1e8;
      --text: #1d1d1b;
      --muted: #655f57;
      --accent: #1d1d1b;
      --accent-soft: #dfc6a8;
      --line: rgba(29, 29, 27, 0.12);
      --shadow: 0 18px 45px rgba(40, 30, 20, 0.08);
      --radius: 20px;
      --max: 1100px;
    }

    * { box-sizing: border-box; }

    html { scroll-behavior: smooth; }

    html, body {
      margin: 0;
      padding: 0;
    }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      color: var(--text);
      background: var(--bg-soft);
      line-height: 1.6;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    a:hover { opacity: 0.82; }

    .container {
      width: min(var(--max), calc(100% - 36px));
      margin: 0 auto;
    }

    /* NAVIGATION */

    .topbar {
      position: sticky;
      top: 0;
      z-index: 30;
      backdrop-filter: blur(14px);
      background: rgba(245, 236, 223, 0.92);
      border-bottom: 1px solid var(--line);
    }

    .nav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 72px;
      gap: 20px;
    }

    .brand {
      font-size: 17px;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 4px;
      white-space: nowrap;
    }

    .navlinks {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 5px;
      flex-wrap: wrap;
    }

    .navlinks a {
      padding: 9px 11px;
      border-radius: 10px;
      color: var(--muted);
      font-size: 13px;
      letter-spacing: 0.3px;
    }

    .navlinks a:hover { color: var(--text); }

    .navlinks a.active {
      color: var(--text);
      background: rgba(248, 241, 232, 0.95);
    }

    .navlinks a.cta {
      background: var(--accent);
      color: #fff;
      padding-left: 16px;
      padding-right: 16px;
    }

    /* HERO */

    .hero {
      padding: 28px 0 18px;
    }

    .heroVisual {
      position: relative;
      min-height: 620px;
      overflow: hidden;
      border-radius: 24px;
      box-shadow: var(--shadow);
      background: #222;
    }

    .heroVisual img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .heroShade {
      position: absolute;
      inset: 0;
      background:
        linear-gradient(
          to top,
          rgba(10,10,10,.68) 0%,
          rgba(10,10,10,.25) 48%,
          rgba(10,10,10,.06) 100%
        );
    }

    .heroContent {
      position: absolute;
      left: 44px;
      right: 44px;
      bottom: 44px;
      max-width: 760px;
      color: #fff;
    }

    .eyebrow {
      margin-bottom: 10px;
      font-size: 12px;
      letter-spacing: 4px;
      text-transform: uppercase;
    }

    .heroTitle {
      margin: 0;
      font-size: clamp(42px, 7vw, 78px);
      line-height: 1;
      font-weight: 400;
      letter-spacing: 5px;
      text-transform: uppercase;
    }

    .heroLead {
      max-width: 640px;
      margin: 18px 0 0;
      font-size: 18px;
      line-height: 1.55;
    }

    /* GENERAL */

    .section {
      padding: 34px 0;
    }

    .sectionIntro {
      max-width: 760px;
      margin-bottom: 22px;
    }

    .sectionLabel {
      display: block;
      margin-bottom: 8px;
      color: var(--muted);
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    h2 {
      margin: 0 0 14px;
      font-size: clamp(28px, 4vw, 42px);
      line-height: 1.15;
      font-weight: 400;
      letter-spacing: 1.5px;
    }

    h3 {
      margin: 0 0 8px;
      font-size: 21px;
      font-weight: 500;
    }

    p {
      margin: 0 0 14px;
      color: var(--muted);
    }

    .split {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 18px;
      align-items: start;
    }

    .card {
      border: 1px solid var(--line);
      background: rgba(248, 241, 232, 0.84);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      padding: 28px;
    }

    .darkCard {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }

    .darkCard p {
      color: rgba(255,255,255,.76);
    }

    /* BUTTONS */

    .ctaRow {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      margin-top: 24px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 45px;
      padding: 11px 16px;
      border: 1px solid var(--line);
      border-radius: 10px;
      background: transparent;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: .2px;
      transition: transform .2s ease, opacity .2s ease;
    }

    .btn:hover { transform: translateY(-1px); }

    .btn.primary {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }

    .darkCard .btn.primary,
    .heroContent .btn.primary {
      background: #fff;
      border-color: #fff;
      color: var(--text);
    }

    .heroContent .btn {
      border-color: rgba(255,255,255,.55);
      color: #fff;
    }

    /* EXPERIENCE CARDS */

    .experienceGrid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .experience {
      min-height: 220px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .number {
      display: block;
      margin-bottom: 28px;
      color: var(--muted);
      font-size: 12px;
      letter-spacing: 2px;
    }

    /* GALLERY */

    .gallery {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 10px;
    }

    .img {
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 14px;
      background: var(--accent-soft);
      aspect-ratio: 4 / 3;
    }

    .img.wide {
      aspect-ratio: 16 / 10;
    }

    .img img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    /* LIST */

    .list {
      margin: 12px 0 0;
      padding-left: 20px;
      color: var(--muted);
    }

    .list li { margin: 8px 0; }

    /* FINAL CTA */

    .finalCta {
      padding: 38px;
      text-align: center;
    }

    .finalCta p {
      max-width: 660px;
      margin-left: auto;
      margin-right: auto;
    }

    .finalCta .ctaRow {
      justify-content: center;
    }

    /* FOOTER */

    .footer {
      padding: 34px 0 40px;
      margin-top: 25px;
      border-top: 1px solid var(--line);
      color: var(--muted);
      font-size: 13px;
    }

    .footerInner {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
    }

    @media (max-width: 960px) {
      .split,
      .experienceGrid {
        grid-template-columns: 1fr;
      }

      .heroVisual {
        min-height: 560px;
      }
    }

    @media (max-width: 720px) {
      .container {
        width: min(var(--max), calc(100% - 24px));
      }

      .nav {
        align-items: flex-start;
        flex-direction: column;
        padding: 15px 0;
      }

      .brand {
        letter-spacing: 3px;
      }

      .navlinks {
        justify-content: flex-start;
      }

      .hero {
        padding-top: 16px;
      }

      .heroVisual {
        min-height: 620px;
        border-radius: 17px;
      }

      .heroContent {
        left: 22px;
        right: 22px;
        bottom: 24px;
      }

      .heroTitle {
        letter-spacing: 3px;
      }

      .heroLead {
        font-size: 16px;
      }

      .card,
      .finalCta {
        padding: 22px;
      }

      .gallery {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>

<body>

